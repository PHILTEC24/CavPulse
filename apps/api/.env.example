PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://cavpulse:cavpulse_secret@localhost:5432/cavpulse?schema=public"

# Redis
REDIS_URL="redis://:cavpulse_redis_secret@localhost:6379"

# JWT
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# QR Code
QR_TOKEN_EXPIRY_SECONDS=60
QR_REFRESH_INTERVAL_SECONDS=55

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Email (for production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@cavpulse.ac.ug
SMTP_PASS=your_smtp_password
SMTP_FROM="CavPulse <noreply@cavpulse.ac.ug>"

# Frontend URL
FRONTEND_URL=http://localhost:3000

